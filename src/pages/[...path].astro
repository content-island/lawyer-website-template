---
/**
 * Every page of the site in a single route, so the default language has no prefix and no redirects.
 *   default language (first in Content Island):  /   /articles/   /articles/<slug>/   /<legal-slug>
 *   other languages:                             /es/  /es/articulos/  /es/articulos/<slug>/  /es/<legal-slug>
 * Routes and their language alternates are built in src/common/routing (site-pages.business.ts).
 */
import { LANGUAGES, routes } from '@common/constants';
import { buildSitePages, toPathParam, type SitePage } from '@common/routing';
import { getSiteRoutingData } from '@common/api';
import Layout from '@layouts/Layout.astro';
import PageMetaPod from '@pods/page-meta/page-meta.pod.astro';
import HeaderPod from '@pods/header/header.pod.astro';
import FooterPod from '@pods/footer/footer.pod.astro';
import HeroSectionPod from '@pods/hero-section/hero-section.pod.astro';
import CredentialsSectionPod from '@pods/credentials-section/credentials-section.pod.astro';
import AreasSectionPod from '@pods/areas-section/areas-section.pod.astro';
import WhySectionPod from '@pods/why-section/why-section.pod.astro';
import AboutSectionPod from '@pods/about-section/about-section.pod.astro';
import ProcessSectionPod from '@pods/process-section/process-section.pod.astro';
import CtaSectionPod from '@pods/cta-section/cta-section.pod.astro';
import ReviewsSectionPod from '@pods/reviews-section/reviews-section.pod.astro';
import FaqSectionPod from '@pods/faq-section/faq-section.pod.astro';
import ArticleLatestPod from '@pods/article/latest/article-latest.pod.astro';
import ContactSectionPod from '@pods/contact-section/contact-section.pod.astro';
import ArticleListPod from '@pods/article/list/article-list.pod.astro';
import ArticleDetailPod from '@pods/article/detail/article-detail.pod.astro';
import LegalPagePod from '@pods/legal-page/legal-page.pod.astro';

export const getStaticPaths = async () => {
  const pages = buildSitePages(await getSiteRoutingData(LANGUAGES), routes);
  return pages.map(page => ({ params: { path: toPathParam(page.url) }, props: { page } }));
};

const { page } = Astro.props as { page: SitePage };
const { lang } = page;
---

<Layout lang={lang}>
  <PageMetaPod slot="head" page={page} />
  <HeaderPod lang={lang} alternates={page.alternates} onHome={page.kind === 'home'} />
  {
    page.kind === 'home' && (
      <main>
        <HeroSectionPod lang={lang} />
        <CredentialsSectionPod lang={lang} />
        <AreasSectionPod lang={lang} />
        <WhySectionPod lang={lang} />
        <AboutSectionPod lang={lang} />
        <ProcessSectionPod lang={lang} />
        <CtaSectionPod lang={lang} />
        <ReviewsSectionPod lang={lang} />
        <FaqSectionPod lang={lang} />
        <ArticleLatestPod lang={lang} />
        <ContactSectionPod lang={lang} />
      </main>
    )
  }
  {page.kind === 'articles' && <ArticleListPod lang={lang} />}
  {page.kind === 'article' && <ArticleDetailPod lang={lang} slug={page.slug} />}
  {page.kind === 'legal' && <LegalPagePod lang={lang} type={page.legalType} />}
  <FooterPod lang={lang} />
</Layout>
