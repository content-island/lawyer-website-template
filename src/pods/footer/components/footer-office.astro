---
import type { FooterOfficeVm } from '../footer.model';

interface Props {
  office: FooterOfficeVm;
}
const { office } = Astro.props;
const link = 'no-underline transition-colors hover:text-on-ink';
---

<div>
  <h4 class="text-on-ink mb-4 text-[12px] font-semibold tracking-[0.18em] uppercase">{office.title}</h4>
  <ul class="m-0 grid list-none gap-[9px] p-0">
    <li set:html={office.addressHtml} />
    <li><a class={link} href={office.phone.href}>{office.phone.label}</a></li>
    <li><a class={link} href={office.email.href}>{office.email.label}</a></li>
    <li><a class={link} href={office.book.href}>{office.book.label}</a></li>
  </ul>
</div>
