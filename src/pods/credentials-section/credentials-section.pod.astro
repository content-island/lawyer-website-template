---
import type { LanguageCode } from '@content-island/api-client';
import { getCredentialsSection } from './api/credentials-section.api';
import { mapToCredentialsVm } from './credentials-section.mapper';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const credentials = mapToCredentialsVm(await getCredentialsSection(lang));
---

<section class="bg-subtle border-rule border-y" aria-label={credentials.label}>
  <div class="wrap grid grid-cols-[1fr_auto] items-end gap-10 py-[clamp(40px,5vw,64px)] max-tab:grid-cols-1 max-tab:gap-5">
    <p class="font-title text-ink-soft max-w-[34em] text-[clamp(24px,2.7vw,36px)] leading-[1.4] text-pretty" data-reveal set:html={credentials.textHtml} />
    <a
      class="group border-accent border-b pb-[3px] text-[15px] font-semibold whitespace-nowrap no-underline"
      href={credentials.link.href}
      data-reveal="right"
      style="--reveal-delay:150ms"
      >{credentials.link.label}
      <span class="ease-soft inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span></a
    >
  </div>
</section>
