---
import type { LanguageCode } from '@content-island/api-client';
import { sanitizeHTMLWithMarked } from '@common/helpers';
import { routes } from '@common/constants';
import type { LegalType } from '@common/routing';
import { getLegalPage, getUiText } from './api/legal-page.api';
import { mapToLegalPageVm } from './legal-page.mapper';

interface Props {
  lang: LanguageCode;
  type: LegalType;
}

const { lang, type } = Astro.props;
const [page, ui] = await Promise.all([getLegalPage(lang, type), getUiText(lang)]);
const vm = mapToLegalPageVm(page, await sanitizeHTMLWithMarked(page.text), ui, lang, routes);
---

<main class="wrap max-w-[820px] pt-16 pb-24">
  <a class="text-ink-soft hover:text-accent text-[14px] font-semibold no-underline" href={vm.backLink.href}>{vm.backLink.label}</a>
  <article
    class="[&_h1]:font-title [&_h2]:font-title [&_li]:text-ink-soft [&_p]:text-ink-soft [&_strong]:text-ink [&_h1]:mt-6 [&_h1]:mb-7 [&_h1]:text-[clamp(34px,4.4vw,48px)] [&_h2]:mt-8 [&_h2]:mb-2.5 [&_h2]:text-[24px] [&_li]:mb-3 [&_p]:mb-3 [&_.legal-updated]:-mt-4 [&_.legal-updated]:mb-8 [&_.legal-updated]:text-[14px]"
    set:html={vm.html}
  />
</main>
