---
/** Article header: with a cover image (darkened with the theme ink) or a colored typographic cover */
import type { ArticleHeroVm } from '../detail/article-detail.model';

interface Props {
  hero: ArticleHeroVm;
}
const { hero } = Astro.props;
---

<header class:list={['text-on-ink relative overflow-hidden', hero.cover ? 'bg-ink' : hero.coverTone]}>
  {
    hero.cover && (
      <>
        <img class="absolute inset-0 size-full object-cover" src={hero.cover.url} alt={hero.cover.alt} width="1536" height="864" />
        <span
          class="absolute inset-0 bg-[linear-gradient(90deg,color-mix(in_oklab,var(--color-ink)_88%,transparent)_0%,color-mix(in_oklab,var(--color-ink)_55%,transparent)_100%)]"
          aria-hidden="true"
        />
      </>
    )
  }
  <div class="wrap relative pt-10 pb-14 max-sm:pt-8 max-sm:pb-10">
    <a class="text-on-ink/80 hover:text-on-ink text-[14px] font-semibold no-underline" href={hero.backLink.href}>← {hero.backLink.label}</a>
    <div class="mt-10 flex items-end justify-between gap-10 max-tab:flex-col max-tab:items-start max-tab:gap-6">
      <div class="max-w-[760px]" data-reveal>
        <p class="text-[12.5px] font-semibold tracking-[0.16em] uppercase">{hero.category}</p>
        <h1 class="font-title mt-4 text-[clamp(34px,4.4vw,52px)] leading-[1.1] tracking-[-0.01em]">{hero.title}</h1>
        <p class="text-on-ink/80 mt-5 text-[14px] tabular-nums">
          <time datetime={hero.dateIso}>{hero.dateLabel}</time> · {hero.readingTime}
        </p>
      </div>
      <!-- Opacity goes on the inner span so the reveal animation doesn't override it -->
      <span aria-hidden="true" data-reveal="right"
        ><span class="font-title block text-[clamp(64px,8vw,112px)] leading-[0.9] opacity-30">{hero.reference}</span></span
      >
    </div>
  </div>
</header>
