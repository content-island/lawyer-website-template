---
/** Page listing all articles (/articles/ in the default language, /es/articulos/ in Spanish). */
import type { LanguageCode } from '@content-island/api-client';
import { routes } from '@common/constants';
import { getArticles, getArticlesExtra, getUiText } from '../api/article.api';
import ArticleCard from '../components/article-card.astro';
import { mapToArticleListVm } from './article-list.mapper';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const [articles, extra, ui] = await Promise.all([getArticles(lang), getArticlesExtra(lang), getUiText(lang)]);
const vm = mapToArticleListVm(articles, extra, ui, lang, routes);
---

<main>
  <section class="pt-[clamp(48px,7vw,96px)] pb-[clamp(72px,9vw,120px)]">
    <div class="wrap">
      <a class="text-ink-soft hover:text-accent text-[14px] font-semibold no-underline" href={vm.backLink.href}>{vm.backLink.label}</a>
      <div class="grid-12 mt-8 mb-[clamp(40px,5vw,64px)]">
        <p class="eyebrow col-[1/4] pt-3 max-tab:col-span-full max-tab:pt-0" data-reveal>{vm.eyebrow}</p>
        <div class="col-[4/11] flex flex-col gap-[18px] max-tab:col-span-full">
          <h1 class="h2" data-reveal="up" style="--reveal-delay:80ms" set:html={vm.titleHtml} />
          <p class="lead" data-reveal="up" style="--reveal-delay:160ms">{vm.lead}</p>
        </div>
      </div>
      <div class="border-ink grid grid-cols-3 gap-x-9 gap-y-14 border-t pt-10 max-lg:grid-cols-2 max-sm:grid-cols-1" data-reveal-group="90">
        {vm.cards.map(card => <ArticleCard article={card} showExcerpt readMoreLabel={vm.readMoreLabel} />)}
      </div>
    </div>
  </section>
</main>
