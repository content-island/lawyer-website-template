---
import type { LanguageCode } from '@content-island/api-client';
import { routes } from '@core/constants';
import { formatLongDate, sanitizeHTMLWithMarked } from '@core/helpers';
import { getUiText } from '@layouts/api';
import { getLegalPage, type LegalType } from './api';

interface Props {
  lang: LanguageCode;
  type: LegalType;
}

const { lang, type } = Astro.props;
const [{ text, lastUpdate }, ui] = await Promise.all([getLegalPage(lang, type), getUiText(lang)]);
// The last revision date goes right below the title (the first h1 in the markdown)
const updated = `<p class="legal-updated"><time datetime="${lastUpdate}">${ui.legalUpdatedLabel}: ${formatLongDate(lastUpdate, lang)}</time></p>`;
const body = await sanitizeHTMLWithMarked(text);
const html = body.includes('</h1>') ? body.replace('</h1>', `</h1>${updated}`) : updated + body;
---

<main class="wrap max-w-[820px] pt-16 pb-24">
  <a class="text-ink-soft hover:text-accent text-[14px] font-semibold no-underline" href={routes.home(lang)}>{ui.backToHomeLabel}</a>
  <article
    class="[&_h1]:font-title [&_h2]:font-title [&_li]:text-ink-soft [&_p]:text-ink-soft [&_strong]:text-ink [&_h1]:mt-6 [&_h1]:mb-7 [&_h1]:text-[clamp(34px,4.4vw,48px)] [&_h2]:mt-8 [&_h2]:mb-2.5 [&_h2]:text-[24px] [&_li]:mb-3 [&_p]:mb-3 [&_.legal-updated]:-mt-4 [&_.legal-updated]:mb-8 [&_.legal-updated]:text-[14px]"
    set:html={html}
  />
</main>
