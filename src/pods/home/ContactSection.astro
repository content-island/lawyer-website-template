---
import type { LanguageCode } from '@content-island/api-client';
import { renderEmphasis, renderLines } from '@core/helpers';
import { getLawyerPage, getSettings, getUiText } from '@layouts/api';

interface Props {
  lang: LanguageCode;
  sectionId: string;
  privacyUrl: string;
}
const { lang, sectionId, privacyUrl } = Astro.props;
const [{ contact }, settings, ui] = await Promise.all([getLawyerPage(lang), getSettings(lang), getUiText(lang)]);

const a = 'no-underline border-b border-on-ink/35 transition-colors hover:border-on-ink';
const details = [
  { label: ui.contactOfficeLabel, html: renderLines(settings.address) },
  { label: ui.contactPhoneLabel, html: `<a class="${a}" href="${settings.phoneHref}">${settings.phone}</a>` },
  { label: ui.contactWhatsappLabel, html: `<a class="${a}" href="${settings.whatsappHref}" target="_blank" rel="noopener noreferrer">${settings.whatsapp}</a>` },
  { label: ui.contactEmailLabel, html: `<a class="${a}" href="mailto:${settings.email}">${settings.email}</a>` },
  { label: ui.contactScheduleLabel, html: renderLines(settings.schedule) },
];
---

<section class="section bg-ink text-on-ink border-t-0" id={sectionId}>
  <div class="wrap grid-12">
    <div class="col-[1/6] max-lg:col-span-full">
      <p class="eyebrow text-accent-light" data-reveal>{contact.eyebrow}</p>
      <h2 class="h2 mt-4 mb-[22px]" data-reveal="up" style="--reveal-delay:80ms" set:html={renderEmphasis(contact.title, 'italic text-accent-light')} />
      <p class="lead text-on-ink/75" data-reveal="up" style="--reveal-delay:160ms">{contact.lead}</p>
      <dl class="mt-9 mb-0 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3.5 text-[15.5px] max-sm:grid-cols-1 max-sm:gap-1" data-reveal style="--reveal-delay:240ms">
        {
          details.map(d => (
            <>
              <dt class="text-muted-inverse pt-[3px] text-[12.5px] font-semibold tracking-[0.14em] uppercase">{d.label}</dt>
              <dd class="m-0 max-sm:mb-3" set:html={d.html} />
            </>
          ))
        }
      </dl>
    </div>

    <form
      class="bg-page text-ink col-[7/13] p-[clamp(22px,3.5vw,40px)] max-lg:col-span-full max-lg:mt-4"
      novalidate
      data-intake
      data-reveal="right"
      style="--reveal-delay:150ms"
    >
      <h3 class="font-title mb-1.5 text-[24px]">{contact.formTitle}</h3>
      <p class="text-ink-soft mb-6 text-[14.5px]">{contact.formSubtitle}</p>
      <div class="grid grid-cols-2 gap-[18px] max-sm:grid-cols-1">
        <div class="field"><label for="f-nombre">{ui.formNameLabel}</label><input id="f-nombre" name="nombre" autocomplete="name" required /></div>
        <div class="field"><label for="f-tel">{ui.formPhoneLabel}</label><input id="f-tel" name="telefono" type="tel" autocomplete="tel" required /></div>
        <div class="field"><label for="f-email">{ui.formEmailLabel}</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field">
          <label for="f-area">{ui.formSubjectLabel}</label>
          <select id="f-area" name="area">{contact.subjects.map(s => <option>{s}</option>)}</select>
        </div>
        <div class="field col-span-full">
          <label for="f-msg">{ui.formMessageLabel}</label>
          <textarea id="f-msg" name="mensaje" placeholder={ui.formMessagePlaceholder}></textarea>
        </div>
      </div>
      <div class="border-rule bg-surface text-ink-soft mt-[18px] border p-3.5 text-[12.5px] leading-[1.5]" aria-label={ui.formGdprLabel}>
        <table class="w-full border-collapse">
          {
            contact.gdpr.map(row => (
              <tr>
                <th scope="row" class="text-ink py-[3px] pr-3 text-left align-top font-semibold whitespace-nowrap max-sm:block max-sm:pt-1.5">
                  {row.title}
                </th>
                <td class="py-[3px] max-sm:block">{row.detail}</td>
              </tr>
            ))
          }
        </table>
      </div>
      <label class="check mt-4" for="f-ok"
        ><input type="checkbox" id="f-ok" name="acepto" required /> <span
          >{contact.consent} <a class="text-accent" href={privacyUrl}>{ui.formPrivacyLinkLabel}</a>.</span
        ></label
      >
      <div class="mt-[22px] flex flex-wrap items-center justify-between gap-4 max-sm:flex-col max-sm:items-stretch max-sm:text-center">
        <button class="btn btn--solid" type="submit">{contact.submitLabel}</button>
        <small class="text-ink-soft text-[13px]">{contact.responseTime}</small>
      </div>
      <p class="form-msg" role="status" aria-live="polite" data-intake-msg data-error={ui.formErrorMessage} data-success={ui.formSuccessMessage}></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-intake]');
  const msg = document.querySelector<HTMLElement>('[data-intake-msg]');
  form?.addEventListener('submit', event => {
    event.preventDefault();
    if (!msg) return;
    if (!form.checkValidity()) {
      msg.className = 'form-msg err';
      msg.textContent = msg.dataset.error ?? '';
      return;
    }
    msg.className = 'form-msg ok';
    msg.textContent = msg.dataset.success ?? '';
    form.reset();
  });
</script>
