---
import type { LanguageCode } from '@content-island/api-client';
import { SectionHead } from '@common/components';
import { getReviewsSection } from './api/reviews-section.api';
import { mapToReviewsVm } from './reviews-section.mapper';
import ReviewCard from './components/review-card.astro';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const reviews = mapToReviewsVm(await getReviewsSection(lang), lang);
---

{
  reviews && (
    <section class="section" id={reviews.id}>
      <div class="wrap">
        <SectionHead head={reviews.head} />
        <div
          class="grid snap-x snap-mandatory auto-cols-[calc((100%-80px)/3)] grid-flow-col gap-10 overflow-x-auto scroll-smooth [scrollbar-width:none] max-xl:auto-cols-[calc((100%-40px)/2)] max-sm:auto-cols-[88%] max-sm:gap-6 [&::-webkit-scrollbar]:hidden"
          tabindex="0"
          aria-label={reviews.label}
          data-reviews
          data-reveal-group="110"
        >
          {reviews.items.map(review => <ReviewCard review={review} />)}
        </div>
        <div class="mt-9 flex justify-end gap-3">
          <button class="arrow max-sm:size-[42px] max-sm:text-[17px]" type="button" aria-label={reviews.prevLabel} data-reviews-prev>←</button>
          <button class="arrow max-sm:size-[42px] max-sm:text-[17px]" type="button" aria-label={reviews.nextLabel} data-reviews-next>→</button>
        </div>
      </div>
    </section>
  )
}

<script>
  const track = document.querySelector<HTMLElement>('[data-reviews]');
  const prev = document.querySelector<HTMLButtonElement>('[data-reviews-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-reviews-next]');
  if (track && prev && next) {
    const page = () => {
      const card = track.querySelector<HTMLElement>('figure');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -page() }));
    next.addEventListener('click', () => track.scrollBy({ left: page() }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
