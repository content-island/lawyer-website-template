---
/** Three or more languages: globe icon + current language, with a dropdown of languages written in their own language */
import type { LanguageOptionVm, LanguageSwitcherVm } from '../header.model';

interface Props {
  switcher: LanguageSwitcherVm;
  current: LanguageOptionVm;
}
const { switcher, current } = Astro.props;
---

<details class="group relative" data-lang-menu>
  <summary
    class="border-rule hover:border-ink inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full border px-3 py-[7px] text-[13px] font-semibold tracking-[0.06em] transition-colors [&::-webkit-details-marker]:hidden"
    aria-label={`${switcher.label}: ${current.nativeName}`}
  >
    <svg class="text-ink-soft size-4 flex-none max-sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path>
    </svg>
    {current.code}
    <svg class="text-ink-soft size-3.5 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>
  <ul class="bg-surface border-rule absolute top-[calc(100%+8px)] right-0 z-10 m-0 min-w-[180px] list-none rounded-md border p-1.5 shadow-[0_18px_40px_-24px_color-mix(in_oklab,var(--color-ink)_45%,transparent)]">
    {
      switcher.options.map(option => (
        <li>
          <a
            class:list={[
              'flex items-center justify-between gap-4 rounded-sm px-3 py-2 text-[14.5px] no-underline transition-colors',
              option.current ? 'text-ink font-semibold' : 'text-ink-soft hover:bg-subtle hover:text-ink',
            ]}
            href={option.url}
            hreflang={option.lang}
            lang={option.lang}
            aria-current={option.current ? 'true' : undefined}
          >
            {option.nativeName}
            <span class="text-accent text-[12px] font-semibold tracking-[0.08em]">{option.current ? '✓' : option.code}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Language dropdown: closes on outside click or Escape
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]');
  document.addEventListener('click', event => {
    menus.forEach(menu => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') menus.forEach(menu => (menu.open = false));
  });
</script>
