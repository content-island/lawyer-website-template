---
/** Floating WhatsApp button (Figma: WhatsApp Float). Icon only on mobile. */
import type { LanguageCode } from '@content-island/api-client';
import { getSettings, getUiText } from './api/whatsapp-float.api';
import { mapToWhatsappFloatVm } from './whatsapp-float.mapper';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const [settings, ui] = await Promise.all([getSettings(lang), getUiText(lang)]);
const { href, label } = mapToWhatsappFloatVm(settings, ui);
---

<a
  class="bg-ink text-on-ink animate-wa-in ease-soft hover:bg-accent fixed right-5 bottom-5 z-40 flex items-center gap-2.5 py-3 pr-4 pl-3 text-[14px] font-semibold no-underline shadow-[0_8px_24px_color-mix(in_oklab,var(--color-ink)_25%,transparent)] transition-[transform,background-color] duration-250 hover:-translate-y-0.5 max-sm:right-4 max-sm:bottom-4 max-sm:p-3"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6">
    <path
      fill="currentColor"
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"
    ></path>
  </svg>
  <span class="max-sm:hidden">WhatsApp</span>
</a>
