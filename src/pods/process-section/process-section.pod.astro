---
import type { LanguageCode } from '@content-island/api-client';
import { SectionHead } from '@common/components';
import { getProcessSection } from './api/process-section.api';
import { mapToProcessVm } from './process-section.mapper';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const process = mapToProcessVm(await getProcessSection(lang), lang);
---

<section class="section" id={process.id}>
  <div class="wrap">
    <SectionHead head={process.head} />
    <ol class="border-ink m-0 grid list-none grid-cols-3 border-t p-0 max-md:grid-cols-1" data-reveal-group="140">
      {
        process.steps.map(step => (
          <li
            class="border-rule mr-7 border-r pt-7 pr-7 pb-2 last:mr-0 last:border-r-0 max-md:mr-0 max-md:border-r-0 max-md:border-b max-md:pr-0 max-md:pb-6 max-md:last:border-b-0"
            data-reveal
          >
            <span class="font-title text-accent block text-[56px] leading-none">{step.number}</span>
            <h3 class="font-title mt-[18px] mb-2.5 text-[24px] leading-[1.25]">{step.title}</h3>
            <p class="text-ink-soft max-w-[34ch] text-[16.5px]">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
