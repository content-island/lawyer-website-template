---
/** Single article page (/articles/<slug>/ · /es/articulos/<slug>/). */
import type { LanguageCode } from '@content-island/api-client';
import { ArticleCard } from '@components/index';
import { routes } from '@core/constants';
import { coverTone, formatDate, sanitizeHTMLWithMarked } from '@core/helpers';
import { getArticle, getArticles, getArticlesExtra, getHeader, getUiText } from '@layouts/api';

interface Props {
  lang: LanguageCode;
  slug: string;
}
const { lang, slug } = Astro.props;
const [article, all, extra, ui, header] = await Promise.all([
  getArticle(lang, slug),
  getArticles(lang),
  getArticlesExtra(lang),
  getUiText(lang),
  getHeader(lang),
]);
const html = await sanitizeHTMLWithMarked(article.body);
const position = (s: string) => all.findIndex(a => a.slug === s);
const more = all.filter(a => a.slug !== slug).slice(0, 2);
const cover = article.coverImage;
---

<main>
  <!-- Article header: with a cover image (darkened with the theme ink) or a colored typographic cover -->
  <header class:list={['text-on-ink relative overflow-hidden', cover ? 'bg-ink' : coverTone(position(slug))]}>
    {
      cover && (
        <>
          <img class="absolute inset-0 size-full object-cover" src={cover.url} alt={article.coverImageAlt ?? ''} width="1536" height="864" />
          <span class="absolute inset-0 bg-[linear-gradient(90deg,color-mix(in_oklab,var(--color-ink)_88%,transparent)_0%,color-mix(in_oklab,var(--color-ink)_55%,transparent)_100%)]" aria-hidden="true" />
        </>
      )
    }
    <div class="wrap relative pt-10 pb-14 max-sm:pt-8 max-sm:pb-10">
      <a class="text-on-ink/80 hover:text-on-ink text-[14px] font-semibold no-underline" href={routes.articles(lang)}>← {extra.backLabel}</a>
      <div class="mt-10 flex items-end justify-between gap-10 max-tab:flex-col max-tab:items-start max-tab:gap-6">
        <div class="max-w-[760px]" data-reveal>
          <p class="text-[12.5px] font-semibold tracking-[0.16em] uppercase">{article.category}</p>
          <h1 class="font-title mt-4 text-[clamp(34px,4.4vw,52px)] leading-[1.1] tracking-[-0.01em]">{article.title}</h1>
          <p class="text-on-ink/80 mt-5 text-[14px] tabular-nums">
            <time datetime={article.date}>{formatDate(article.date, lang)}</time> · {article.readingTime}
          </p>
        </div>
        <!-- Opacity goes on the inner span so the reveal animation doesn't override it -->
        <span aria-hidden="true" data-reveal="right"
          ><span class="font-title block text-[clamp(64px,8vw,112px)] leading-[0.9] opacity-30">{article.reference}</span></span
        >
      </div>
    </div>
  </header>

  <article class="wrap grid-12 py-[clamp(56px,7vw,96px)]">
    <div class="col-[3/11] max-lg:col-span-full">
      <p class="font-title text-ink text-[clamp(19px,1.8vw,22px)] leading-[1.6]" data-reveal>{article.excerpt}</p>
      <div
        class="mt-10 text-[17px] leading-[1.75] [&_a]:text-accent [&_blockquote]:border-rule [&_blockquote]:text-ink-soft [&_h2]:font-title [&_li]:mb-2 [&_li]:marker:text-accent [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mb-6 [&_strong]:font-semibold [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6 [&_blockquote]:mt-10 [&_blockquote]:border-t [&_blockquote]:pt-5 [&_blockquote]:text-[14px] [&_blockquote]:italic [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-[28px] [&_h2]:leading-[1.2]"
        set:html={html}
      />

      <aside class="bg-subtle border-accent mt-14 border-t-3 p-8 max-sm:p-6" data-reveal="up">
        <h2 class="font-title text-[24px]">{extra.ctaTitle}</h2>
        <p class="text-ink-soft mt-2 mb-6">{extra.ctaText}</p>
        <a class="btn btn--solid max-sm:w-full" href={routes.fromCms(lang, header.contact.url)}>{extra.ctaLabel}</a>
      </aside>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="mb-10 flex items-end justify-between gap-6 max-sm:flex-col max-sm:items-start">
            <h2 class="h2">{ui.moreArticlesTitle}</h2>
            <a class="btn btn--line" href={routes.articles(lang)}>
              {extra.allLabel}
            </a>
          </div>
          <div class="grid grid-cols-2 gap-9 max-sm:grid-cols-1 lg:grid-cols-3" data-reveal-group="120">
            {more.map(item => <ArticleCard article={item} position={position(item.slug)} lang={lang} />)}
          </div>
        </div>
      </section>
    )
  }
</main>
