---
import type { LanguageCode } from '@content-island/api-client';
import { routes } from '@core/constants';
import { coverTone, formatDate } from '@core/helpers';
import type { Article } from '@models/index';

interface Props {
  article: Article;
  /** Position in the full list (most recent = 0): decides the typographic cover color */
  position: number;
  lang: LanguageCode;
  /** Shows the summary below the title (article list) */
  showExcerpt?: boolean;
  readMoreLabel?: string;
}
const { article, position, lang, showExcerpt = false, readMoreLabel } = Astro.props;
---

<a class="group flex flex-col gap-4 no-underline" href={routes.article(lang, article.slug)} data-reveal="zoom">
  {
    article.coverImage ? (
      <div class="bg-placeholder aspect-[3/2] overflow-hidden">
        <img
          class="ease-soft size-full object-cover transition-transform duration-800 group-hover:scale-[1.04]"
          src={article.coverImage.url}
          alt={article.coverImageAlt ?? ''}
          width="600"
          height="400"
          loading="lazy"
        />
      </div>
    ) : (
      <div class:list={['text-on-ink flex aspect-[3/2] flex-col justify-between overflow-hidden p-[22px]', coverTone(position)]}>
        <span class="text-[11.5px] font-semibold tracking-[0.16em] uppercase">{article.category}</span>
        <span class="font-title ease-soft text-[62px] leading-[0.9] opacity-92 transition-transform duration-600 group-hover:translate-x-2" aria-hidden="true">
          {article.reference}
        </span>
      </div>
    )
  }
  <p class="text-ink-soft text-[13px] tabular-nums">
    <time datetime={article.date}>{formatDate(article.date, lang)}</time> · {article.readingTime}
  </p>
  <h3 class="font-title group-hover:text-accent text-[22px] leading-[1.3] transition-colors">{article.title}</h3>
  {showExcerpt && <p class="text-ink-soft text-[15.5px]">{article.excerpt}</p>}
  {
    readMoreLabel && (
      <span class="text-accent text-[15px] font-semibold">
        {readMoreLabel} <span class="ease-soft inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
      </span>
    )
  }
</a>
