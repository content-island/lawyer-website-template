---
/**
 * Logo (Figma: Logo). La marca sale de General.logo (SVG subido a Content Island): se inserta en línea y toma el
 * color del texto, así sirve en claro y en oscuro. Si no hay logo, se dibuja un monograma con las iniciales del nombre.
 * tone="dark" sobre fondos claros, "light" sobre tinta.
 */
import type { Media } from '@models/index';
import { loadSvgLogo } from '@core/helpers';

interface Props {
  /** General.logo (opcional) */
  logo?: Media;
  name: string;
  role: string;
  tone?: 'dark' | 'light';
  href: string;
  /** Texto accesible del enlace a la página de inicio (UiText.logoHomeLabel) */
  homeLabel: string;
}
const { logo, name, role, tone = 'dark', href, homeLabel } = Astro.props;
const svg = logo ? await loadSvgLogo(logo.url) : null;
const initials = name
  .split(' ')
  .map(part => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<a class:list={['flex items-center gap-3.5 no-underline', tone === 'light' && 'text-on-ink']} href={href} aria-label={`${name} ${role}, ${homeLabel}`}>
  {
    svg ? (
      <svg viewBox={svg.viewBox} aria-hidden="true" class="h-[46px] w-auto flex-none max-sm:h-10" {...svg.attributes} set:html={svg.body} />
    ) : logo ? (
      <img src={logo.url} alt="" aria-hidden="true" class="h-[46px] w-auto flex-none max-sm:h-10" />
    ) : (
      <svg viewBox="0 0 64 64" aria-hidden="true" class="size-[46px] flex-none max-sm:size-10">
        <rect x="1" y="1" width="62" height="62" fill="none" stroke="currentColor" stroke-width="1.4" />
        <rect x="5" y="5" width="54" height="54" fill="none" stroke="currentColor" stroke-width=".7" />
        <text x="32" y="41.5" text-anchor="middle" font-family="Libre Caslon Display, Georgia, serif" font-size="25" fill="currentColor" letter-spacing="1">
          {initials}
        </text>
        <line x1="22" y1="48" x2="42" y2="48" stroke="var(--color-accent)" stroke-width="1.4" />
      </svg>
    )
  }
  <span>
    <span class="font-title block text-[23px] leading-none tracking-[0.14em] whitespace-nowrap max-sm:text-[19px]">{name.toUpperCase()}</span>
    <span class:list={['mt-1.5 block text-[11px] tracking-[0.32em] uppercase', tone === 'light' ? 'text-muted-inverse' : 'text-ink-soft']}>{role}</span>
  </span>
</a>
