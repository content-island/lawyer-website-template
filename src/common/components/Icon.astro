---
import type { Media } from '@models/index';
import { loadSvgIcon } from '@core/helpers';

interface Props {
  icon: Media;
  size?: number;
  class?: string;
}

const { icon, size = 24, class: className } = Astro.props;
const svg = await loadSvgIcon(icon.url);
---

{
  svg ? (
    <svg class={className} width={size} height={size} viewBox={svg.viewBox} aria-hidden="true" {...svg.attributes} set:html={svg.body} />
  ) : (
    <img class={className} src={icon.url} width={size} height={size} alt="" aria-hidden="true" loading="lazy" />
  )
}
