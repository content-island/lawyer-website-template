---
/**
 * Document shell. Pages put their own <head> tags in the "head" slot (see the page-meta pod).
 * Composes the document-level pods: site head (favicon, fonts, theme), WhatsApp button and cookie banner.
 */
import type { LanguageCode } from '@content-island/api-client';
import SiteHeadPod from '@pods/site-head/site-head.pod.astro';
import WhatsappFloatPod from '@pods/whatsapp-float/whatsapp-float.pod.astro';
import CookieBannerPod from '@pods/cookie-banner/cookie-banner.pod.astro';
import '@/styles/global.css';

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SiteHeadPod lang={lang} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <WhatsappFloatPod lang={lang} />
    <CookieBannerPod lang={lang} />

    <script>
      // Fade-in from the left when entering the viewport.
      // Children of [data-reveal-group] are staggered automatically.
      document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach(group => {
        const step = Number(group.dataset.revealGroup) || 90;
        group.querySelectorAll<HTMLElement>(':scope > [data-reveal]').forEach((el, i) => {
          el.style.setProperty('--reveal-delay', `${i * step}ms`);
        });
      });

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        targets.forEach(el => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        targets.forEach(el => observer.observe(el));
      }
    </script>
  </body>
</html>
