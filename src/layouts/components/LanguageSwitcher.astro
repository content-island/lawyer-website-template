---
/**
 * Selector de idioma. Cada opción lleva a la MISMA página en ese idioma.
 *   1 idioma   → no se muestra
 *   2 idiomas  → conmutador con icono de traducir y los dos códigos (el actual marcado).
 *                En móvil solo el icono y el idioma al que se cambia, para que quepa junto al logo y el menú
 *   3 o más    → icono de bola del mundo + idioma actual, con desplegable de idiomas escritos en su propio idioma
 * El orden es el de Content Island (Idiomas).
 */
import { nativeLanguageName, type LanguageAlternate } from '@core/helpers';

interface Props {
  alternates: LanguageAlternate[];
  /** UiText.languageLabel ("Idioma" / "Language") */
  label: string;
}
const { alternates, label } = Astro.props;
const current = alternates.find(a => a.current);
const code = (lang: string) => lang.toUpperCase();
const pill = 'border-rule inline-flex items-center rounded-full border text-[13px] font-semibold tracking-[0.06em]';
---

{
  alternates.length === 2 && (
    <div class:list={[pill, 'gap-1 py-1 pr-1 pl-2.5 max-sm:gap-0 max-sm:pl-2']} role="group" aria-label={label}>
      <svg class="text-ink-soft mr-0.5 size-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m5 8 6 6" /><path d="m4 14 6-6 2-3" /><path d="M2 5h12" /><path d="M7 2h1" /><path d="m22 22-5-10-5 10" /><path d="M14 18h6" />
      </svg>
      {alternates.map(alt =>
        alt.current ? (
          <span class="bg-ink text-on-ink rounded-full px-2.5 py-1 max-sm:hidden" aria-current="true" title={nativeLanguageName(alt.lang)}>
            {code(alt.lang)}
          </span>
        ) : (
          <a
            class="text-ink-soft hover:text-accent rounded-full px-2.5 py-1 no-underline transition-colors"
            href={alt.url}
            hreflang={alt.lang}
            lang={alt.lang}
            title={nativeLanguageName(alt.lang)}
            aria-label={nativeLanguageName(alt.lang)}
          >
            {code(alt.lang)}
          </a>
        ),
      )}
    </div>
  )
}

{
  alternates.length > 2 && current && (
    <details class="group relative" data-lang-menu>
      <summary class:list={[pill, 'hover:border-ink cursor-pointer list-none gap-1.5 px-3 py-[7px] transition-colors [&::-webkit-details-marker]:hidden']} aria-label={`${label}: ${nativeLanguageName(current.lang)}`}>
        <svg class="text-ink-soft size-4 flex-none max-sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />
        </svg>
        {code(current.lang)}
        <svg class="text-ink-soft size-3.5 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <ul class="bg-surface border-rule absolute top-[calc(100%+8px)] right-0 z-10 m-0 min-w-[180px] list-none rounded-md border p-1.5 shadow-[0_18px_40px_-24px_color-mix(in_oklab,var(--color-ink)_45%,transparent)]">
        {alternates.map(alt => (
          <li>
            <a
              class:list={[
                'flex items-center justify-between gap-4 rounded-sm px-3 py-2 text-[14.5px] no-underline transition-colors',
                alt.current ? 'text-ink font-semibold' : 'text-ink-soft hover:bg-subtle hover:text-ink',
              ]}
              href={alt.url}
              hreflang={alt.lang}
              lang={alt.lang}
              aria-current={alt.current ? 'true' : undefined}
            >
              {nativeLanguageName(alt.lang)}
              <span class="text-accent text-[12px] font-semibold tracking-[0.08em]">{alt.current ? '✓' : code(alt.lang)}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  // Desplegable de idiomas: se cierra al pulsar fuera o con Escape
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]');
  document.addEventListener('click', event => {
    menus.forEach(menu => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') menus.forEach(menu => (menu.open = false));
  });
</script>
